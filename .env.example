# 仅作启动变量参考，不需要复制为 .env；实际部署值直接编辑 docker-compose.yml。
# Compose 已固定注入默认后台账号 admin / admin、端口、目录和时区。

# 管理端登录（仅供参考，Compose 默认直接使用 admin/admin）
APEX_USER=admin
APEX_PASSWORD=admin

# HTTPS 反向代理部署时设为 true，启用 Secure Cookie
APEX_COOKIE=false

# 两个容器监听端口（宿主机映射固定写在 docker-compose.yml）
APEX_ADMIN_PORT=8000
APEX_PORTAL_PORT=8080

# 数据库、secret.key 与确认入库海报目录
APEX_DATA=/data
APEX_IMAGE=/image

# 运营配置（注册、通知、TMDB 等）请在管理端「设置」页维护。
